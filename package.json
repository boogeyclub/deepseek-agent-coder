{
  "name": "deepseek-agent-coder",
  "displayName": "DeepSeek Agent Coder",
  "description": "DeepSeek chat agent for VS Code - a dockable chat panel that talks to the DeepSeek API with your own key.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "deepseek",
    "ai",
    "chat",
    "assistant",
    "copilot"
  ],
  "activationEvents": [
    "onView:deepseekAgent.chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekAgent",
          "title": "DeepSeek Agent",
          "icon": "media/deepseek.svg"
        }
      ]
    },
    "views": {
      "deepseekAgent": [
        {
          "type": "webview",
          "id": "deepseekAgent.chat",
          "name": "Chat",
          "icon": "media/deepseek.svg",
          "contextualTitle": "DeepSeek Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "deepseekAgent.openChat",
        "title": "Open Chat",
        "category": "DeepSeek"
      },
      {
        "command": "deepseekAgent.chat.focus",
        "title": "Focus on Chat View",
        "category": "DeepSeek"
      },
      {
        "command": "deepseekAgent.newChat",
        "title": "New Chat",
        "category": "DeepSeek",
        "icon": "$(add)"
      },
      {
        "command": "deepseekAgent.openSettings",
        "title": "Chat Settings",
        "category": "DeepSeek",
        "icon": "$(gear)"
      },
      {
        "command": "deepseekAgent.setApiKey",
        "title": "Set API Key",
        "category": "DeepSeek"
      },
      {
        "command": "deepseekAgent.clearApiKey",
        "title": "Clear API Key",
        "category": "DeepSeek"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deepseekAgent.newChat",
          "when": "view == deepseekAgent.chat",
          "group": "navigation@1"
        },
        {
          "command": "deepseekAgent.openSettings",
          "when": "view == deepseekAgent.chat",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "deepseekAgent.chat.focus",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Agent",
      "properties": {
        "deepseekAgent.model": {
          "type": "string",
          "default": "deepseek-chat",
          "enum": [
            "deepseek-chat",
            "deepseek-reasoner"
          ],
          "enumDescriptions": [
            "General purpose model (DeepSeek-V3).",
            "Reasoning model (DeepSeek-R1) that thinks before answering."
          ],
          "description": "Model used by the DeepSeek chat panel."
        },
        "deepseekAgent.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "Base URL of the DeepSeek API. Point this at a compatible gateway or a local proxy if you use one."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.145.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
